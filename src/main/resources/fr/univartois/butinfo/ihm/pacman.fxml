<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.control.Button?>
<BorderPane fx:controller="fr.univartois.butinfo.ihm.controller.PacmanController"
            style="-fx-background-color: #000000;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox style="-fx-background-color: black; -fx-padding: 10;"
              spacing="40" alignment="CENTER">
            <Label fx:id="scoreLabel" text="Score : 0" style="-fx-text-fill: yellow; -fx-font-size: 16;"/>
        </HBox>
    </top>

    <center>
        <GridPane fx:id="mapGrid" hgap="0" vgap="0" alignment="CENTER" BorderPane.alignment="CENTER"/>
    </center>

    <bottom>
        <HBox style="-fx-background-color: black; -fx-padding: 10;"
              spacing="10" alignment="CENTER_LEFT">
            <Label text="Vies :" style="-fx-text-fill: yellow; -fx-font-size: 14;"/>
            <Label fx:id="livesLabel" text="❤ ❤ ❤ " style="-fx-text-fill: red; -fx-font-size: 14;"/>
            <Button text="Restart" style="-fx-background-color: pink; -fx-text-fill: black;" onAction="#restart"/>
        </HBox>
    </bottom>
</BorderPane>
